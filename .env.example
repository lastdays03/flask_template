# Flask
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/oauth/google/callback

# Sentry
SENTRY_DSN=

# Database (Container Setup)
MYSQL_ROOT_PASSWORD=root_password
MYSQL_USER=flask_user
MYSQL_PASSWORD=flask_password
MYSQL_DATABASE=flask_app

# Database (App Connection)
# Docker 내부에서는 'mariadb' 호스트네임 사용
DATABASE_URL=mysql+pymysql://flask_user:flask_password@localhost:40002/flask_app
# DATABASE_URL=mysql+pymysql://flask_user:flask_password@mariadb:40002/flask_app

# Redis
# Docker 내부에서는 'redis' 호스트네임 사용
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Flower
FLOWER_USER=admin
FLOWER_PASSWORD=change_me

# CORS
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Rate Limiting
RATELIMIT_STORAGE_URL=redis://redis:6379/2

# Logging
LOG_LEVEL=INFO
